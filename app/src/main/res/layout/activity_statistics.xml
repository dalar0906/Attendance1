<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_page">
 <LinearLayout android:id="@+id/main" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <Button android:id="@+id/btnStatisticsBack" android:layout_width="wrap_content" android:layout_height="44dp" android:text="← Назад" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="История и статистика посещаемости" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Фильтр по группе" android:textColor="@color/text_secondary" android:textStyle="bold"/>
   <Spinner android:id="@+id/spStatisticsGroup" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Фильтр по студенту" android:textColor="@color/text_secondary" android:textStyle="bold"/>
   <Spinner android:id="@+id/spStatisticsStudent" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
    <Button android:id="@+id/btnDateFrom" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Дата начала: любая" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
    <Button android:id="@+id/btnDateTo" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Дата окончания: любая" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
   </LinearLayout>
   <Button android:id="@+id/btnResetFilters" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Сбросить фильтры" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Сводка" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card">
   <TextView android:id="@+id/tvStatLessons" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="Количество занятий: 0" android:textSize="16sp" android:textColor="@color/text_primary"/>
   <TextView android:id="@+id/tvStatTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="Всего отметок: 0" android:textSize="16sp" android:textColor="@color/text_primary"/>
   <TextView android:id="@+id/tvStatPresent" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="Присутствовали: 0" android:textSize="16sp" android:textColor="@color/status_present"/>
   <TextView android:id="@+id/tvStatAbsent" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="Отсутствовали: 0" android:textSize="16sp" android:textColor="@color/status_absent"/>
   <TextView android:id="@+id/tvStatLate" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="Опоздали: 0" android:textSize="16sp" android:textColor="@color/status_late"/>
  </LinearLayout>
  <TextView android:id="@+id/tvStatisticsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="20dp" android:text="Нет отметок, подходящих под выбранные фильтры." android:textColor="@color/text_secondary" android:visibility="gone"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="История посещаемости" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
  <TextView android:id="@+id/tvStatisticsHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:textIsSelectable="true" android:textSize="15sp" android:textColor="@color/text_primary"/>
 </LinearLayout>
</ScrollView>