<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_page">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="44dp" android:text="← Назад" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Посещаемость студента" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center"/>
 </LinearLayout>
 <TextView android:id="@+id/tvStudentInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:padding="12dp" android:background="@drawable/bg_card"/>
 <Button android:id="@+id/btnDate" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <EditText android:id="@+id/etNewSubject" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:hint="Новый предмет" android:inputType="textCapSentences" android:maxLength="50" android:paddingStart="10dp" android:background="@drawable/bg_input"/>
  <Button android:id="@+id/btnAddSubject" android:layout_width="wrap_content" android:layout_height="50dp" android:text="Добавить" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
 </LinearLayout>
 <TextView android:id="@+id/tvHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Выберите статус по каждому предмету и нажмите «Сохранить» — запишутся все выбранные предметы сразу. Предметы без выбора не сохраняются." android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:layout_marginBottom="6dp"/>
 <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Список предметов пуст. Добавьте предмет выше." android:textColor="@color/text_secondary" android:gravity="center" android:padding="16dp" android:visibility="gone"/>
 <ListView android:id="@+id/lvSubjects" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="8dp"/>
 <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="Сохранить посещаемость" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@color/primary_blue"/>
</LinearLayout>