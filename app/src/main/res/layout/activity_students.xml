<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_page">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
  <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="44dp" android:text="← Назад" android:textAllCaps="false" android:textColor="@color/primary_blue" android:backgroundTint="@color/accent_blue_light"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Студенты" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card" android:layout_marginBottom="12dp">
  <EditText android:id="@+id/etLastName" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Фамилия" android:inputType="textPersonName" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_input"/>
  <EditText android:id="@+id/etFirstName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:hint="Имя" android:inputType="textPersonName" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_input"/>
  <EditText android:id="@+id/etGroup" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:hint="Группа (например, ИС-21)" android:inputType="text" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_input"/>
  <Button android:id="@+id/btnAddStudent" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Добавить студента" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@color/primary_blue"/>
 </LinearLayout>
 <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Список пуст. Добавьте первого студента." android:textColor="@color/text_secondary" android:gravity="center" android:padding="16dp" android:visibility="gone"/>
 <ListView android:id="@+id/lvStudents" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider_soft" android:dividerHeight="1dp" android:padding="6dp" android:background="@drawable/bg_card"/>
</LinearLayout>